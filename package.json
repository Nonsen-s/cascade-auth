{
  "name": "cascade-player-accounts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server:setup": "tsx server/src/setup.ts",
    "server:dev": "tsx watch server/src/main.ts",
    "server:start": "node server/dist/main.js",
    "server:build": "tsc -p server/tsconfig.json && tsup --config server/tsup.config.ts",
    "server:migrate": "tsx server/src/migrate.ts",
    "server:worker": "tsx server/src/worker.ts",
    "test:server": "node scripts/local-qa.mjs server",
    "build": "npm run build:web && npm run server:build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/local-qa.mjs unit",
    "test:watch": "node scripts/local-qa.mjs watch",
    "test:e2e": "node scripts/local-qa.mjs e2e",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "typecheck:qa": "node scripts/local-qa.mjs types",
    "check:local": "npm run check && npm run typecheck:qa && npm test && npm run test:server",
    "docker:setup": "node scripts/setup-docker.mjs",
    "docker:build": "node scripts/docker.mjs build",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:status": "docker compose --env-file .env.docker ps"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "@playwright/test": "^1.56.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.14.2",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smtp-server": "^3.21.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
