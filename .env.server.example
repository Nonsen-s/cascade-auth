NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Generate private development keys with npm run server:setup.
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
DB_DRIVER=postgres
DATABASE_URL=postgresql://cascade:CHANGE_ME@127.0.0.1:5432/cascade
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTO_MIGRATE=false
# Only the addresses of your actual reverse proxies. Empty means trust none.
TRUST_PROXY=
HASH_CONCURRENCY=2
MAIL_TRANSPORT=smtp
MAIL_FROM=accounts@example.com
MAIL_ACTIVE_KEY_ID=v1
MAIL_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_64_HEX_CHARACTERS"}
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Allow plaintext ONLY with a local test SMTP server; production rejects true.
SMTP_ALLOW_PLAINTEXT=true
SMTP_USER=
SMTP_PASSWORD=
RUN_MAIL_WORKER=true
LOG_LEVEL=info
